# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Backup files
*.bak
*.backup
*~

# Generated files (theme cache)
active-theme.sh

# Editor files
*.swp
*.swo
.vscode/
.idea/

# Compiled files
*.pyc
__pycache__/

# Local overrides (for user-specific settings)
*.local
*.local.sh

# But stow packages use .local/ as a real directory — don't ignore it
!*/.local/
!*/.local/**

# Auto-generated by sketchybar-app-font
sketchybar/.config/sketchybar/utils/

# Compiled native helper binary
sketchybar/.config/sketchybar/native/helper

# Claude Code settings
.claude/
.cursor/
!/claude/.claude/

# Pi agent: machine-specific model config (varies per machine, may reveal models used)
pi/.pi/agent/models.json
pi/.pi/agent/models-store.json

# Pi agent: credentials and generated/installed artifacts
pi/.pi/agent/auth.json
pi/.pi/agent/install/
pi/.pi/agent/npm/
pi/.pi/agent/sessions/

# Local settings files that may hold credentials or machine-specific config
*.local.json
claude/.claude/.credentials.json
