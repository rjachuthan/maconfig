#!/bin/bash

# Load central configuration and libraries
source "$HOME/.config/sketchybar/config.sh"

# Setting up and starting the helper process
killall helper 2>/dev/null
cd "$NATIVE_DIR" && make 2>/dev/null
"$NATIVE_DIR/helper" "$HELPER_NAME" >/dev/null 2>&1 &

# Setting up the general bar appearance and default values
sketchybar --bar height=$BAR_HEIGHT \
  color=$BAR_COLOR \
  border_color=$BAR_BORDER_COLOR \
  border_width=1 \
  shadow=off \
  position=top \
  sticky=on \
  padding_right=$BAR_PADDING_RIGHT \
  padding_left=$BAR_PADDING_LEFT \
  corner_radius=$BAR_CORNER_RADIUS \
  y_offset=$BAR_Y_OFFSET \
  margin=$BAR_MARGIN \
  blur_radius=$BAR_BLUR_RADIUS \
  notch_width=$BAR_NOTCH_WIDTH \
  \
  --default updates=when_shown \
  icon.font="$ICON_FONT" \
  icon.color=$ICON_COLOR \
  icon.padding_left=$PADDINGS \
  icon.padding_right=$PADDINGS \
  label.font="$LABEL_FONT" \
  label.color=$LABEL_COLOR \
  label.padding_left=$PADDINGS \
  label.padding_right=$PADDINGS \
  padding_right=$PADDINGS \
  padding_left=$PADDINGS \
  background.height=$BACKGROUND_HEIGHT \
  background.corner_radius=$BACKGROUND_CORNER_RADIUS \
  popup.background.border_width=$POPUP_BORDER_WIDTH \
  popup.background.corner_radius=$POPUP_CORNER_RADIUS \
  popup.background.border_color=$POPUP_BORDER_COLOR \
  popup.background.color=$POPUP_BACKGROUND_COLOR \
  popup.background.shadow.drawing=on

# Fixed-width spacer between right-side pills
add_gap() {
  sketchybar --add item "$1" right \
    --set "$1" width=6 padding_left=0 padding_right=0 \
    icon.drawing=off label.drawing=off background.drawing=off
}

# Left: [app icon + name] [mode tag, only outside aerospace's main mode]
source "$MODULE_DIR/apps/front_app.item.sh"
sketchybar --add bracket focus front_app \
  --set focus "${pill[@]}"
source "$MODULE_DIR/workspace/mode.item.sh"

# Right
source "$MODULE_DIR/ui/calendar.item.sh"
source "$MODULE_DIR/integrations/brew.item.sh"
source "$MODULE_DIR/integrations/weather.item.sh"
add_gap gap.weather
source "$MODULE_DIR/system/battery.item.sh"
source "$MODULE_DIR/system/volume.item.sh"
add_gap gap.status
source "$MODULE_DIR/system/cpu.item.sh"

# Group right-side items into matching pills
sketchybar --add bracket status battery volume_icon \
  --set status "${pill[@]}" \
  \
  --add bracket cpu cpu.user cpu.top \
  --set cpu "${pill[@]}" background.border_width=0

# Restore zen mode across reloads
is_zen_mode && enable_zen_mode

# Forcing all item scripts to run (never do this outside of sketchybarrc)
sketchybar --update

echo "sketchybar configuration loaded.."
